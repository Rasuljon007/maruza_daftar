# ─────────────────────────────────────────────────────────────
# Ma'ruza Daftari: environment variables (noutbuk + tekin AI varianti)
# Bu faylni .env deb nusxalang va qiymatlarni O'ZINGIZ kiriting:
#   Windows:  copy .env.example .env
#   mac/Linux: cp .env.example .env
# .env hech qachon GitHub'ga yuklanmaydi (.gitignore'da bor).
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Bo'sh qoldiring: Cloudflare tunnel manzili avtomatik aniqlanadi.
# Doimiy domen bo'lsa shu yerga yozing (oxirida / bo'lmasin).
APP_URL=

# ── Maxfiy qiymat (o'zingiz generatsiya qilasiz) ─────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── PostgreSQL: Neon (tekin bulut). Dashboard → Connect, pooling o'chiq ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# ── Fayllar (audio, rasmlar) noutbukda saqlanadi ─────────────
STORAGE_DIR=D:/maruza-daftari-data

# ── Transkripsiya: Groq (tekin) ──────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
TRANSCRIBE_PROVIDER=groq
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ── Tahlil, rasm o'qish, chat: Google Gemini (tekin) ─────────
# https://aistudio.google.com/apikey  (billing YOQMANG)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash

# ── Keyinchalik pullik variantga o'tish uchun (hozir bo'sh) ──
# AI_PROVIDER=anthropic, AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# TRANSCRIBE_PROVIDER=openai, TRANSCRIBE_MODEL=whisper-1
OPENAI_API_KEY=

# ── Telegram bot (long polling, webhook kerak emas) ──────────
TELEGRAM_BOT_TOKEN=
# @ belgisisiz, masalan: maruza_daftari_bot
TELEGRAM_BOT_USERNAME=

# ── Ixtiyoriy ────────────────────────────────────────────────
# cloudflared PATH'da bo'lmasa, to'liq yo'lini yozing:
# CLOUDFLARED_PATH=C:/Program Files (x86)/cloudflared/cloudflared.exe
# Sinov uchun AI'siz rejim: TRANSCRIBE_PROVIDER=fake va AI_PROVIDER=fake

# ── Cheklovlar (o'zgartirish shart emas) ─────────────────────
MAX_UPLOAD_MB=300
# Bitta foydalanuvchi uchun 1 soatda nechta AI so'rov
RATE_LIMIT_PER_HOUR=60
